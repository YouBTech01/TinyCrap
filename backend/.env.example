# Copy to .env (local) or set these in cPanel > Application Manager > Environment variables.
# Every value is optional; defaults are shown.

# Where temporary media is stored. Auto-deleted after CLEANUP_MINUTES.
# TINYCRAP_TEMP_DIR=/home/USER/tinycrap_tmp
TINYCRAP_CLEANUP_MINUTES=30

# Limits
TINYCRAP_MAX_CONCURRENT_JOBS=2
TINYCRAP_MAX_QUEUED_JOBS=200
TINYCRAP_MAX_JOBS_PER_CLIENT=8
TINYCRAP_MAX_CONCURRENT_ANALYZE=3
TINYCRAP_MAX_FILESIZE_MB=500
TINYCRAP_MAX_DURATION_SEC=10800
TINYCRAP_ANALYZE_TIMEOUT=45
TINYCRAP_JOB_TIMEOUT=900
TINYCRAP_RATE_LIMIT_PER_MIN=30

# Optional shared secret. If set, the app must send it in the X-API-Key header.
# TINYCRAP_API_KEY=change-me

# Set to 1 when running behind a reverse proxy so client IPs are read correctly.
# TINYCRAP_TRUST_PROXY=1

# Tool locations if they are not on PATH (file or directory).
# TINYCRAP_FFMPEG_PATH=/home/USER/bin
# TINYCRAP_FFPROBE_PATH=/home/USER/bin/ffprobe
# JavaScript runtime used by yt-dlp for YouTube (deno, node or bun).
# TINYCRAP_JS_RUNTIME=node

TINYCRAP_LOG_LEVEL=INFO

# Admin panel (/admin, user "admin"). If empty, a password is generated into data/admin_password.txt.
# TINYCRAP_ADMIN_PASSWORD=choose-a-long-password
# Where lifetime counters, API keys and update notices are stored.
# TINYCRAP_DATA_DIR=/home/USER/tinycrap_data
